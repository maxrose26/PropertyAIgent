--- a/verification/discovery/r0_recovery_proposal.py
+++ b/verification/discovery/r0_recovery_proposal.py
@@ -0,0 +1,187 @@
+"""Unregistered R0 recovery proposal; no CLI, dispatch, credentials or writer.
+
+Only the 28 untouched windows are admitted. Existing R0 execution is unchanged.
+The caller must be registered with reviewed revision/run/authority and use the
+existing outer supervisor before any live execution can be proposed as ready.
+"""
+import os
+import math
+import re
+import time
+from datetime import datetime, timezone
+from . import finite_acceptance as f
+from . import r0_proposal as original
+
+SOURCE_RUN = 38731487848
+LIMITS = dict(calls=28, requests=1120, bytes=48_000_000 + 240*1024*1024,
+              seconds=1900, output_bytes=20_000_000)
+
+
+def proposal():
+    rows = [dict(r) for r in original.PLAN['rounds'][0]['rows']
+            if r['council'] not in {'bolton', 'bury'}]
+    return dict(version=1, purpose='UNATTEMPTED_R0_RECOVERY', source_run=SOURCE_RUN,
+                source_manifest=original.PLAN_HASH, rows=rows, limits=LIMITS.copy(),
+                unresolved_required_window='bury:2026-10-08:2026-10-14',
+                bridge_start='2026-10-15', persistence=False, watermark_advance=False,
+                publication_coverage='UNKNOWN', latency='UNKNOWN')
+
+
+PLAN = proposal()
+PLAN_HASH = f.digest(PLAN)
+
+
+def resources(row, audit):
+    """Certain, finite source accounting; unknown or out-of-bounds stops all."""
+    arc = row['council'] in f.ARCUS
+    resource = audit if arc else audit.get('resource', {})
+    count = resource.get('requests', resource.get('requests_attempted'))
+    if arc:
+        sizes = [audit.get(k) for k in ('decoded_bytes', 'encoded_bytes', 'outbound_payload_bytes')]
+        if any(type(n) is not int or n < 0 for n in sizes):
+            return None
+        size = max(sizes[:2]) + sizes[2]
+    else:
+        size = resource.get('received_bytes')
+    if (type(count) is not int or type(size) is not int
+            or not 0 <= count <= (80 if arc else 10)
+            or not 0 <= size <= (20*1024*1024 if arc else 3_000_000)):
+        return None
+    return count, size
+
+
+def safety(row, a):
+    """Fail closed before treating any gap as local. No source errors continue."""
+    arc = row['council'] in f.ARCUS
+    if (a.get('persistence') is not False or a.get('failure') is not None
+            or a.get('accounting_complete') is False
+            or a.get('requested_interval') != [row['start'], row['end']]
+            or a.get('date_semantics') != row['semantics']
+            or not identities(row, a)):
+        return False
+    if arc:
+        case = 'discovery_' + row['council'] + '_ui_window'
+        config = f.dated_config(f.UI_CASES[case], row['start'], row['end'])
+        return (a.get('case') == case and a.get('destination') == config.destination
+                and a.get('safety_failure') is False and a.get('safety_events') == []
+                and a.get('cleanup') == 'CONTEXT_BROWSER_CLOSED'
+                and a.get('process_cleanup') == 'CLOSED'
+                and type(a.get('live_owned_survivors')) is int and a['live_owned_survivors'] == 0
+                and a.get('supervisor_limit_hit') is False
+                and type(a.get('supervisor_seconds')) in (int, float)
+                and 0 <= a['supervisor_seconds'] <= 45
+                and a.get('measured_public_ui_posts') == a.get('public_ui_posts')
+                and type(a.get('public_ui_posts')) is int
+                and 1 <= a['public_ui_posts'] <= a['requests']
+                and a.get('pages') == 1 and type(a.get('navigations')) is int
+                and 1 <= a['navigations'] <= 2)
+    resource = a.get('resource', {})
+    elapsed = resource.get('elapsed_seconds')
+    return (a.get('council') == row['council'] and a.get('cleanup') == 'SESSION_BOUNDARY_CLOSED'
+            and resource.get('budget_exhaustion') is False
+            and type(elapsed) in (int, float) and math.isfinite(elapsed) and 0 <= elapsed <= 45
+            and not a.get('safety_failure') and not a.get('safety_events'))
+
+
+def identities(row, a):
+    """Identity safety applies to every child, including count-COMPLETE ones."""
+    arc = row['council'] in f.ARCUS
+    records = a.get('listing_records' if arc else 'records')
+    if not isinstance(records, list):
+        return False
+    refs, keys = [], []
+    for record in records:
+        if not isinstance(record, dict):
+            return False
+        ref = record.get('reference'); key = record.get('source_record_id' if arc else 'source_key')
+        if (not isinstance(ref, str) or not ref.strip() or ref != ref.strip()
+                or len(ref) > 100 or any(ord(c) < 32 for c in ref)
+                or not isinstance(key, str) or not key
+                or (not arc and record.get('identity_state') != 'PRESENT_VALUE')):
+            return False
+        refs.append(ref); keys.append(key)
+    if len(set(refs)) != len(refs) or len(set(keys)) != len(keys):
+        return False
+    return True
+
+
+def local_gap(row, a):
+    """Only missing count/terminal or an ordinary page cap can continue.
+
+    Identity conflicts, source exceptions and unclassified failures remain hard
+    stops. Complete child contracts continue to use the original classifier.
+    """
+    arc = row['council'] in f.ARCUS
+    if not identities(row, a):
+        return False
+    if a.get('applied_interval') != [row['start'], row['end']]:
+        return False
+    fingerprint = a.get('applied_evidence_sha256')
+    if not arc and (not isinstance(fingerprint, str) or not re.fullmatch('[0-9a-f]{64}', fingerprint)
+                    or a.get('applied_evidence') not in {'STRICT_REFINE_FORM_ECHO', 'STRICT_ZERO_RESULT_FORM_ECHO'}):
+        return False
+    # Do not silently reinterpret an arbitrary listing_failure or exception.
+    if a.get('listing_failure') is not None:
+        return False
+    pages = a.get('listing_segments' if arc else 'pages')
+    if not isinstance(pages, list) or not 1 <= len(pages) <= 6:
+        return False
+    return (a.get('enumeration_evidence') in {'TOTAL_UNKNOWN', 'PAGE_CAP'}
+            or a.get('capped') is True)
+
+
+def execute(plan, expected_hash, *, reader, clock=time.monotonic):
+    """Preparation API with explicit reader injection; no live entrypoint."""
+    if plan != PLAN or expected_hash != PLAN_HASH:
+        raise ValueError('RECOVERY_MANIFEST_REJECTED')
+    if any(k in os.environ for k in ('DATABASE_URL', 'COMMITTEE_DATABASE_URL',
+                                    'OPENAI_API_KEY', 'ANTHROPIC_API_KEY')):
+        raise ValueError('CREDENTIAL_CONTEXT_REJECTED')
+    started = clock(); results = []; requests = size = 0; stop = None; certain = True
+    for row in plan['rows']:
+        arc = row['council'] in f.ARCUS
+        if (requests + (80 if arc else 10) > LIMITS['requests']
+                or size + (20*1024*1024 if arc else 3_000_000) > LIMITS['bytes']
+                or clock() - started + 55 > LIMITS['seconds']):
+            stop = 'ROUND_BUDGET'; break
+        stamp = datetime.now(timezone.utc).isoformat()
+        try:
+            a = dict(reader(row))
+            a['primary_observation'] = dict(started_at=stamp, ended_at=datetime.now(timezone.utc).isoformat())
+        except Exception:
+            certain = False
+            results.append(dict(window=row, enumeration_completeness='FAILED', completeness='FAILED', reason='SOURCE_EXCEPTION'))
+            stop = 'SOURCE_EXCEPTION'; break
+        cost = resources(row, a)
+        if cost is None:
+            certain = False
+            results.append(dict(window=row, enumeration_completeness='UNKNOWN', completeness='UNKNOWN', reason='RESOURCE_ACCOUNTING'))
+            stop = 'RESOURCE_ACCOUNTING'; break
+        requests += cost[0]; size += cost[1]
+        if a.get('accounting_complete') is False:
+            certain = False
+        state = f.classify(row, a)
+        safe = safety(row, a)
+        # Safety dominates even an apparently COMPLETE child.
+        if not safe:
+            state = 'FAILED'
+        local = safe and state != 'COMPLETE' and local_gap(row, a)
+        results.append(dict(window=row, source=a, enumeration_completeness=state,
+                            completeness='UNKNOWN' if state == 'COMPLETE' else state,
+                            safe_local_gap=local))
+        if not safe or (state != 'COMPLETE' and not local):
+            stop = 'SAFETY_OR_UNCLASSIFIED_FAILURE'; break
+    if stop is None and clock() - started > LIMITS['seconds']:
+        stop = 'ROUND_DEADLINE'
+    result = dict(manifest_sha256=PLAN_HASH, results=results,
+                  not_attempted=plan['rows'][len(results):], stop_reason=stop,
+                  enumeration_completeness='COMPLETE' if stop is None and all(
+                      x['enumeration_completeness'] == 'COMPLETE' for x in results) else 'INCOMPLETE',
+                  # Prior Bury gap alone prevents parent R0 coverage COMPLETE.
+                  completeness='INCOMPLETE', source_contract_qualified=False,
+                  accounting_complete=certain, requests=requests, bytes=size,
+                  persistence=False, completed_through_advanced=False)
+    import json
+    if len(json.dumps(result).encode()) > LIMITS['output_bytes']:
+        raise ValueError('OUTPUT_LIMIT')
+    return result
--- a/tests/test_discovery_r0_recovery_proposal.py
+++ b/tests/test_discovery_r0_recovery_proposal.py
@@ -0,0 +1,139 @@
+from copy import deepcopy
+import pytest
+from verification.discovery import r0_recovery_proposal as r
+from verification.discovery import finite_acceptance as f
+from tests.test_discovery_finite_acceptance import evidence as original_evidence
+
+
+def evidence(row):
+    a = original_evidence(row)
+    if row['council'] not in f.ARCUS:
+        a['resource'].update(budget_exhaustion=False, elapsed_seconds=1)
+        a['applied_evidence'] = 'STRICT_REFINE_FORM_ECHO'
+    return a
+
+
+@pytest.fixture(autouse=True)
+def no_credentials(monkeypatch):
+    monkeypatch.delenv('DATABASE_URL', raising=False)
+
+
+def test_exact_28_previously_unattempted_windows():
+    assert len(r.PLAN['rows']) == 28
+    assert {x['council'] for x in r.PLAN['rows']} == f.COUNCILS - {'bolton', 'bury'}
+    assert all(x['start'] >= '2026-09-17' and x['end'] <= '2026-10-14' for x in r.PLAN['rows'])
+    bad = deepcopy(r.PLAN); bad['rows'][0]['council'] = 'bury'
+    with pytest.raises(ValueError):
+        r.execute(bad, f.digest(bad), reader=lambda _: pytest.fail('source called'))
+    with pytest.raises(ValueError):
+        r.execute(r.PLAN, '0'*64, reader=lambda _: pytest.fail('source called'))
+
+
+def test_safe_unknown_continues_but_never_claims_parent_complete():
+    calls = []
+    def reader(row):
+        calls.append(row)
+        a = evidence(row)
+        if len(calls) == 5:  # First Idox row after four Manchester windows.
+            a.update(enumeration_evidence='TOTAL_UNKNOWN', explicit_zero_evidence=None)
+        return a
+    result = r.execute(r.PLAN, r.PLAN_HASH, reader=reader, clock=lambda: 0)
+    assert len(calls) == 28 and not result['not_attempted']
+    assert result['results'][4]['safe_local_gap'] is True
+    assert result['results'][4]['enumeration_completeness'] == 'UNKNOWN'
+    assert result['completeness'] == 'INCOMPLETE' and result['accounting_complete'] is True
+    assert not result['persistence'] and not result['completed_through_advanced']
+
+
+def test_complete_recovery_still_cannot_erase_prior_bury_gap():
+    result = r.execute(r.PLAN, r.PLAN_HASH, reader=evidence, clock=lambda: 0)
+    assert result['enumeration_completeness'] == 'COMPLETE'
+    assert result['completeness'] == 'INCOMPLETE' and result['source_contract_qualified'] is False
+
+
+@pytest.mark.parametrize('change,reason', [
+    ({'cleanup': 'FAILED'}, 'SAFETY_OR_UNCLASSIFIED_FAILURE'),
+    ({'safety_failure': True}, 'SAFETY_OR_UNCLASSIFIED_FAILURE'),
+    ({'safety_events': ['ORIGIN_DENIED']}, 'SAFETY_OR_UNCLASSIFIED_FAILURE'),
+    ({'process_cleanup': 'UNKNOWN'}, 'SAFETY_OR_UNCLASSIFIED_FAILURE'),
+    ({'live_owned_survivors': 1}, 'SAFETY_OR_UNCLASSIFIED_FAILURE'),
+    ({'supervisor_limit_hit': True}, 'SAFETY_OR_UNCLASSIFIED_FAILURE'),
+    ({'requests': None}, 'RESOURCE_ACCOUNTING'),
+    ({'decoded_bytes': -1}, 'RESOURCE_ACCOUNTING'),
+    ({'requests': 81}, 'RESOURCE_ACCOUNTING'),
+    ({'accounting_complete': False}, 'SAFETY_OR_UNCLASSIFIED_FAILURE'),
+    ({'failure': 'UNCLASSIFIED_FAILURE'}, 'SAFETY_OR_UNCLASSIFIED_FAILURE'),
+    ({'destination': 'https://wrong.invalid/'}, 'SAFETY_OR_UNCLASSIFIED_FAILURE'),
+    ({'applied_interval': None}, 'SAFETY_OR_UNCLASSIFIED_FAILURE'),
+])
+def test_unsafe_or_uncertain_failures_stop_remaining_scope(change, reason):
+    calls=[]
+    def reader(row):
+        calls.append(row); return dict(evidence(row), **change)
+    out=r.execute(r.PLAN, r.PLAN_HASH, reader=reader, clock=lambda: 0)
+    assert len(calls)==1 and len(out['not_attempted'])==27 and out['stop_reason']==reason
+    assert out['completeness']=='INCOMPLETE'
+    if reason=='RESOURCE_ACCOUNTING': assert out['accounting_complete'] is False
+    if change.get('accounting_complete') is False: assert out['accounting_complete'] is False
+
+
+def test_exception_is_bounded_and_uncertain_accounting_stops():
+    def reader(_): raise RuntimeError('private payload must not escape')
+    result=r.execute(r.PLAN,r.PLAN_HASH,reader=reader,clock=lambda:0)
+    assert result['stop_reason']=='SOURCE_EXCEPTION' and not result['accounting_complete']
+    assert 'private payload' not in str(result)
+
+
+def test_caps_not_resource_or_identity_relaxation():
+    row=next(x for x in r.PLAN['rows'] if x['council']=='oldham')
+    a=evidence(row);a.update(capped=True,enumeration_evidence='PAGE_CAP',completeness='INCOMPLETE')
+    assert r.safety(row,a) and r.local_gap(row,a)
+    a['records']=[{'reference':None,'source_key':'X','identity_state':'UNKNOWN'}]
+    assert not r.local_gap(row,a)
+    a['records']=[];a['failure']='BoundaryFailure:origin'
+    assert not r.safety(row,a)
+
+
+def test_complete_idox_identity_failure_stops_not_just_unknown_gaps():
+    calls=[]
+    def reader(row):
+        calls.append(row);a=evidence(row)
+        if row['council']=='oldham':
+            a['records']=[dict(reference='TEST/26',source_key='X',identity_state='UNKNOWN')]
+            a['pages']=[dict(first=1,last=1,total=1,terminal=True)]
+        return a
+    result=r.execute(r.PLAN,r.PLAN_HASH,reader=reader,clock=lambda:0)
+    assert len(calls)==5 and result['stop_reason']=='SAFETY_OR_UNCLASSIFIED_FAILURE'
+    assert result['results'][-1]['enumeration_completeness']=='FAILED'
+
+
+@pytest.mark.parametrize('change',[{'applied_evidence_sha256':None},{'applied_evidence_sha256':''},
+                                  {'applied_evidence':'UNKNOWN'},{'applied_evidence_sha256':'invalid'}])
+def test_unknown_gap_cannot_drop_criteria_provenance(change):
+    row=next(x for x in r.PLAN['rows'] if x['council']=='oldham')
+    a=evidence(row);a.update(enumeration_evidence='TOTAL_UNKNOWN',**change)
+    assert not r.local_gap(row,a)
+
+
+def test_arcus_local_gap_requires_safe_identity_and_cleanup():
+    row=r.PLAN['rows'][0];assert row['council']=='manchester'
+    a=evidence(row);a.update(enumeration_evidence='TOTAL_UNKNOWN')
+    assert r.safety(row,a) and r.local_gap(row,a)
+    calls=[]
+    def reader(current):
+        calls.append(current)
+        return a if len(calls)==1 else evidence(current)
+    result=r.execute(r.PLAN,r.PLAN_HASH,reader=reader,clock=lambda:0)
+    assert len(calls)==28 and result['results'][0]['safe_local_gap']
+    assert result['results'][0]['enumeration_completeness']=='UNKNOWN'
+    assert result['completeness']=='INCOMPLETE'
+    a['listing_records'][0]['reference']=None
+    assert not r.safety(row,a) and not r.local_gap(row,a)
+
+
+def test_outer_deadline_reservation_and_credentials(monkeypatch):
+    times=iter([0,1900])
+    out=r.execute(r.PLAN,r.PLAN_HASH,reader=lambda _:pytest.fail('no call'),clock=lambda:next(times))
+    assert out['stop_reason']=='ROUND_BUDGET' and len(out['not_attempted'])==28
+    monkeypatch.setenv('COMMITTEE_DATABASE_URL','synthetic')
+    with pytest.raises(ValueError):r.execute(r.PLAN,r.PLAN_HASH,reader=lambda _:pytest.fail('no call'))
