OPENAI_API_KEY=
CH_API_KEY=
APOLLO_API_KEY=
HUNTER_API_KEY=
SERPAPI_KEY=
# Free registration at https://get-energy-performance-data.communities.gov.uk - used for build-status detection (bearer token)
EPC_API_KEY=

# Database (Supabase migration, Stage 1) - leave unset to keep using the
# local SQLite database at data/deal_finder.db, exactly as before. Set this
# to a Supabase/PostgreSQL connection string to use Postgres instead - a
# bare postgresql://... or postgres://... string (as copied straight out
# of Supabase's dashboard) is fine, it's automatically rewritten to use the
# psycopg 3 driver. Never commit a real value here - this file only ever
# holds placeholders; put the real one in your own .env (gitignored).
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres
